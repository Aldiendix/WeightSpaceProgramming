# Copy to .config (never committed). Read by ./gpu (bash) and wsp/config.py (python); environment variables
# with the same names override it. Quote values that contain spaces.

# GPU box (ssh)
WSP_SSH_HOST=203.0.113.10
WSP_SSH_PORT=22
WSP_SSH_USER=root
WSP_SSH_HOSTKEY_ALIAS=            # optional: name the host key is stored under in known_hosts
WSP_SSH_HOSTKEY_ALGOS=            # optional: pin the known host key type, e.g. ecdsa-sha2-nistp256
WSP_SSH_PROXY=                    # optional ProxyCommand, e.g. "nc -X 5 -x 127.0.0.1:1080 %h %p"

# paths on the GPU box
WSP_REMOTE_REPO=/workspace/wsp    # code checkout (./gpu push)
WSP_REMOTE_WORK=/workspace/wsp_work  # disposable big files: models, runs, data cache, queue
WSP_REMOTE_VENV=/workspace/venv
WSP_REMOTE_HF_HOME=/workspace/hf

# R2 target of `python -m wsp.upload` when no task.json is given (S3-compatible; the subnet's task.json carries
# its own temporary key). Deliverables go to s3://$R2_BUCKET/$R2_PREFIX/ (layout: rules.json -> upload).
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SESSION_TOKEN=                 # only for temporary credentials
R2_BUCKET=
R2_PREFIX=
