#!/bin/bash
# GPU box helper; settings in .config (template: config.example). Code and small results live in this repo; the
# GPU box keeps only disposable big files.
#   ./gpu push                     sync code + case files (and .config, mode 600) to the box
#   ./gpu pull                     fetch generated case files (results, RESULTS.md, npz, pairs, sets, manifests)
#   ./gpu run '<cmd>'              run a command there, in the repo with the env activated
#   ./gpu queue [--first] <name> '<cmd>'   append a job (or put it before the pending ones)
#   ./gpu status | worker          queue state | start the queue worker if it is not running
set -e
cd "$(dirname "$0")"
set -a; . ./.config; set +a
SSHCFG=$(mktemp); trap 'rm -f "$SSHCFG"' EXIT
{ echo "Host wsp-gpu"
  echo "  HostName $WSP_SSH_HOST"; echo "  Port ${WSP_SSH_PORT:-22}"; echo "  User ${WSP_SSH_USER:-root}"
  [ -n "$WSP_SSH_HOSTKEY_ALIAS" ] && echo "  HostKeyAlias $WSP_SSH_HOSTKEY_ALIAS"
  [ -n "$WSP_SSH_HOSTKEY_ALGOS" ] && echo "  HostKeyAlgorithms $WSP_SSH_HOSTKEY_ALGOS"
  [ -n "$WSP_SSH_PROXY" ] && echo "  ProxyCommand $WSP_SSH_PROXY"
  echo "  StrictHostKeyChecking yes"; echo "  UserKnownHostsFile ~/.ssh/known_hosts"; echo "  BatchMode yes"
  echo "  ConnectTimeout 30"; echo "  ServerAliveInterval 30"; echo "  ServerAliveCountMax 6"; } > "$SSHCFG"
SSH="ssh -F $SSHCFG wsp-gpu"
ENV="cd $WSP_REMOTE_REPO && . $WSP_REMOTE_VENV/bin/activate && export WSP_WORK=$WSP_REMOTE_WORK HF_HOME=$WSP_REMOTE_HF_HOME PYTHONUNBUFFERED=1 VLLM_LOGGING_LEVEL=WARNING"
cmd=$1; shift || true
case "$cmd" in
  push) rsync -az -e "ssh -F $SSHCFG" --exclude .git --exclude __pycache__ --exclude .work --exclude .config \
          ./ "wsp-gpu:$WSP_REMOTE_REPO/"
        rsync -a --chmod=F600 -e "ssh -F $SSHCFG" .config "wsp-gpu:$WSP_REMOTE_REPO/.config" ;;
  pull) # generated files only; notes (*.md written by hand) are never pulled back
        rsync -az -e "ssh -F $SSHCFG" --include '*/' --include 'results/*.json' --include 'RESULTS.md' \
          --include '*.npz' --include 'pairs*.json' --include 'sets/*.json' --include 'manifest.json' --exclude '*' \
          "wsp-gpu:$WSP_REMOTE_REPO/cases/" ./cases/ ;;
  run) $SSH "$ENV && $1" ;;
  queue) first=""; [ "$1" = --first ] && { first=1; shift; }
         $SSH "$ENV && bash scripts/queue.sh add $1 $(printf '%q' "$2") $first" ;;
  status) $SSH "$ENV && bash scripts/queue.sh status" ;;
  worker) $SSH "$ENV && bash scripts/queue.sh start" ;;
  *) sed -n 2,9p "$0"; exit 1 ;;
esac
